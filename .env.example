# Optional: API keys for full LLM mode (intent classification fallback, draft generation, LLM-as-judge)
# If not provided, the pipeline runs cleanly in 100% deterministic offline mode using local embeddings and rules.

# Groq (Recommended fast inference via OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Other Optional Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# General LLM configuration
LLM_PROVIDER=groq # groq | openai | anthropic
LLM_MODEL=llama-3.3-70b-versatile
LLM_CACHE_DIR=.cache/llm

