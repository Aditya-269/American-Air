# Optional: API keys for LLM intent classification fallback, drafting, and LLM-as-judge
# If not provided, the pipeline runs cleanly in offline mode using deterministic rules and local embeddings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# LLM configuration
LLM_PROVIDER=openai # or anthropic / groq
LLM_MODEL=gpt-4o-mini
LLM_CACHE_DIR=.cache/llm
